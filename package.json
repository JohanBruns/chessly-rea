{
  "name": "chessly-rea",
  "version": "0.1.0",
  "private": true,
  "description": "Persönlicher Eröffnungstrainer im Stil von Chessly: Lernpfad aus Kacheln, Drill, Spaced Repetition, Bot – Repertoires als PGN-Dateien.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copyStockfish.js",
    "predev": "node scripts/copyStockfish.js",
    "dev": "vite",
    "prebuild": "node scripts/copyStockfish.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "upload-videos": "node scripts/uploadVideos.js",
    "deploy": "npm run build && wrangler pages deploy",
    "usage": "node scripts/usage.js",
    "deploy-alert": "wrangler deploy --config usageAlert/wrangler.toml",
    "test-alert": "node scripts/testAlert.js",
    "abgleich": "node scripts/compareCourse.js",
    "neuaufbau": "node scripts/buildFromChessly.js"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.157.0"
  }
}
